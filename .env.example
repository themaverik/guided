# Copy to .env.local for local development. Every value below is optional —
# the defaults are the local-development defaults.

# Storage driver (lib/storage.ts). "fs" writes to data/projects/<slug>;
# "blobs" uses Netlify Blobs. Unset = fs locally, blobs on a Netlify deploy.
GUIDED_STORAGE=fs

# Minutes a project survives before the TTL sweep discards it.
# Deployed value is 60 (see netlify.toml); default is 1440.
# GUIDED_PROJECT_TTL_MIN=1440

# Base URL Playwright loads for server-side PDF export.
# Defaults to http://127.0.0.1:$PORT (3000).
# PDF_BASE_URL=http://127.0.0.1:3000
