# pnpm: hoist ESLint plugins to the project root so eslint-config-next's flat
# config can resolve them (eslint-plugin-react, eslint-plugin-react-hooks,
# @next/eslint-plugin-next). Without this, pnpm's isolated store leaves them
# only nested and `next lint` / `eslint` fail to find the plugins.
public-hoist-pattern[]=*eslint*
